# Valori fittizi: solo per far costruire il client Supabase durante i test
# (createClient valida l'URL ma non si connette mai finche' non si chiama
# una query, e nei test che toccano Supabase il modulo viene mockato).
VITE_SUPABASE_URL=https://test-project.supabase.co
VITE_SUPABASE_ANON_KEY=test-anon-key

# Vuota di proposito: .env.test ha priorita' su .env.local (vedi la
# cascata di Vite), quindi questo sovrascrive sempre un'eventuale site key
# vera gia' configurata in locale — i test su captchaRequired/TurnstileWidget
# (default "nessuna chiave => nessun blocco") restano deterministici
# indipendentemente da cosa c'e' in .env.local di chi esegue i test.
VITE_TURNSTILE_SITE_KEY=
